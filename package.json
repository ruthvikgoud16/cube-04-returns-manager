{
  "name": "rtn-returns-manager",
  "version": "0.1.0",
  "private": true,
  "description": "CUBE 2026 Returns Manager. One vision call per unit, then deterministic policy.",
  "scripts": {
    "build": "tsc",
    "test": "jest --testPathIgnorePatterns=tenancy.pg",
    "test:tenancy": "jest tests/tenancy.pg.test.ts --runInBand",
    "dev": "ts-node src/api/server.ts",
    "start": "node dist/api/server.js",
    "db:up": "docker compose up -d",
    "eval:predict": "ts-node eval/predict.ts",
    "eval:score": "ts-node eval/score.ts",
    "collection:create": "ts-node collection/cli.ts create",
    "collection:publish": "ts-node collection/cli.ts publish",
    "collection:share": "ts-node collection/cli.ts share",
    "collection:list": "ts-node collection/cli.ts list",
    "collection:assign": "ts-node collection/cli.ts assign",
    "collection:revoke": "ts-node collection/cli.ts revoke",
    "collection:status": "ts-node collection/cli.ts status",
    "collection:validate": "ts-node collection/cli.ts validate",
    "collection:export": "ts-node collection/cli.ts export",
    "collection:verify-permissions": "ts-node collection/cli.ts verify-permissions",
    "collection:grade": "ts-node collection/runFifty.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
